{
  "name": "openanimator",
  "productName": "OpenAnimator",
  "version": "0.1.0",
  "description": "OpenAnimator is an open-source vector-based animation tool.",
  "main": "./out/main/index.js",
  "author": "Didier Hoarau",
  "homepage": "https://github.com/DidierHoarau/OpenAnimator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DidierHoarau/OpenAnimator.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "test": "vitest run",
    "dist:linux": "electron-builder --linux",
    "check-version": "node scripts/check-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "semver": "^7.8.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  }
}
